---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import ContactBand from "../components/ContactBand.astro";
import CatalogCovers from "../components/CatalogCovers.astro";
import DivisionCards from "../components/DivisionCards.astro";
import { site } from "../data";

const steps = [
  { title: "Envía tu solicitud", text: "Indica qué necesitas, cuánto y para cuándo." },
  { title: "Revisa las opciones", text: "Confirma materiales y disponibilidad con ventas." },
  { title: "Recibe tu cotización", text: "Recibe el precio y el plazo estimado." },
];
const catalogCount = site.catalogs.length;
---

<Layout title="Merchandising y comunicación visual para empresas">
  <section class="container home-hero">
    <img src={site.home.image} data-content="home.image" alt="Gráfica aplicada a mamparas de oficina" width="1240" height="600" fetchpriority="high" />
    <div class="home-hero-copy">
      <h1 data-content="home.title">{site.home.title}</h1>
      <p data-content="home.description">{site.home.description}</p>
      <a class="button button-light" href="/contacto/">Solicitar cotización <Arrow /></a>
    </div>
  </section>

  <section class="section container home-about" id="nosotros">
    <div>
      <h2>Sobre FAMA</h2>
      <p data-content="about.text">{site.about.text}</p>
      <a class="text-link" href="/nosotros/">Conoce FAMA <Arrow /></a>
    </div>
    <dl class="home-facts">
      <div><dt>Divisiones de negocio</dt><dd>{site.divisions.length}</dd></div>
      <div><dt>Catálogos y fichas PDF</dt><dd>{catalogCount}</dd></div>
      <div><dt>Para empresas</dt><dd>B2B</dd></div>
      <div><dt>Sede comercial</dt><dd>Lima</dd></div>
    </dl>
  </section>

  <section class="section container home-divisions" id="soluciones">
    <div>
      <h2>Nuestras soluciones</h2>
      <p>Publicidad, artículos promocionales y servicios para tus espacios de trabajo.</p>
      <a class="text-link" href="/divisiones/">Ver divisiones <Arrow /></a>
    </div>
    <DivisionCards onHome />
  </section>

  <section class="section container home-process" id="como-cotizar">
    <div>
      <h2>Cómo trabajamos</h2>
      <p>De tu solicitud a una cotización para tu empresa.</p>
      <img src="/assets/vidrio.webp" alt="Comunicación visual aplicada en una oficina" width="510" height="530" loading="lazy" />
    </div>
    <ol class="process-list">
      {steps.map((step, index) => (
        <li>
          <span aria-hidden="true">0{index + 1}</span>
          <div><h3>{step.title}</h3><p>{step.text}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section container home-catalog">
    <div>
      <h2>Catálogos y fichas técnicas</h2>
      <p>Consulta productos, medidas y acabados en los PDF de cada división.</p>
      <a class="button" href="/catalogos/">Ver catálogos <Arrow /></a>
    </div>
    <CatalogCovers />
  </section>

  <section class="section container">
    <div class="section-heading">
      <h2>Productos y aplicaciones</h2>
      <p>Exhibidores, gráfica para oficinas y artículos promocionales.</p>
    </div>
    <div class="gallery-preview">
      {site.gallery.slice(0, 3).map((item, i) => (
        <a class={`project-preview project-${i}`} href={`/proyectos/?division=${item.category}`}>
          <div class="project-image">
            <img src={item.image} alt={item.title} width="640" height="480" loading="lazy" />
            <span class="round-arrow"><Arrow diagonal /></span>
          </div>
          <h3>{item.title}</h3>
        </a>
      ))}
    </div>
    <a class="text-link" href="/proyectos/">Explorar la galería <Arrow /></a>
  </section>
  <ContactBand />
</Layout>
