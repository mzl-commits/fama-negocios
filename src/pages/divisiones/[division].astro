---
import Layout from "../../layouts/Layout.astro";
import Arrow from "../../components/Arrow.astro";
import CatalogList from "../../components/CatalogList.astro";
import CatalogViewer from "../../components/CatalogViewer.astro";
import ContactBand from "../../components/ContactBand.astro";
import { site } from "../../data";
export function getStaticPaths() {
  return site.divisions.map((division) => ({
    params: { division: division.slug },
    props: { division },
  }));
}
const { division } = Astro.props;
const i = site.divisions.findIndex((d) => d.slug === division.slug);
---

<Layout
  title={division.short.replace(/\.$/, "")}
  description={division.description}
>
  <section class="page-intro">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/divisiones/">Soluciones</a>
        <span>/</span>
        <span>{division.name.replace("División ", "")}</span>
      </div>
      <div class="intro-split">
        <div>
          <span class="page-kicker" data-content={`divisions.${i}.name`}>
            {division.name}
          </span>
          <h1 data-content={`divisions.${i}.short`}>{division.short}</h1>
          <p data-content={`divisions.${i}.description`}>
            {division.description}
          </p>
          <a class="button" href={`/contacto/?division=${division.slug}`}>
            Solicitar cotización <Arrow diagonal />
          </a>
        </div>
        <img
          data-content={`divisions.${i}.image`}
          src={division.image}
          alt={division.imageAlt}
          width="640"
          height="450"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>
  <section class="section container">
    <div class="section-heading">
      <h2>Productos y servicios</h2>
      <p>
        Cuéntanos el objetivo, la cantidad y las características que necesitas.
        Te orientamos en las opciones para tu empresa.
      </p>
    </div>
    <div class="services-grid">
      {division.services.map((service, j) => (
        <article class="service-item">
          <h3 data-content={`divisions.${i}.services.${j}.name`}>
            {service.name}
          </h3>
          <p data-content={`divisions.${i}.services.${j}.description`}>
            {service.description}
          </p>
          <a
            class="text-link"
            href={`/contacto/?division=${division.slug}&servicio=${encodeURIComponent(service.name)}`}
          >
            Solicitar cotización <Arrow diagonal />
          </a>
        </article>
      ))}
    </div>
    {division.slug === "servicios-generales" && (
      <aside class="star-feature">
        <div>
          <h3>Star Home</h3>
          <p>
            Conoce la sección diferenciada de Star Home dentro de Servicios
            Generales.
          </p>
        </div>
        <a class="text-link" href="/star-home/">
          Explorar Star Home <Arrow />
        </a>
      </aside>
    )}
    <div style="margin-top:40px;display:flex;gap:30px;flex-wrap:wrap">
      <a class="text-link" href={`/proyectos/?division=${division.slug}`}>
        Ver aplicaciones <Arrow />
      </a>
    </div>
  </section>
  <section class="section container division-documents">
    <h2>Catálogos y documentos</h2>
    <CatalogList division={division.slug} />
    <a class="text-link" href={`/catalogos/#${division.slug}`}>
      Ver biblioteca de catálogos <Arrow />
    </a>
  </section>
  <ContactBand />
  <CatalogViewer />
</Layout>
