---
import Layout from "../../layouts/Layout.astro";
import DivisionCards from "../../components/DivisionCards.astro";
import ContactBand from "../../components/ContactBand.astro";
---

<Layout
  title="Nuestras soluciones"
  description="Explora las divisiones Publicitaria, Promocional y Servicios Generales de FAMA Negocios."
>
  <section class="page-intro">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <span>Soluciones</span>
      </div>
      <h1>
        Soluciones publicitarias,
        <br />
        promocionales y para oficinas.
      </h1>
      <p>
        Tres divisiones que conectan tu marca, tus campañas y tus espacios de
        trabajo.
      </p>
    </div>
  </section>
  <section class="section container">
    <DivisionCards />
  </section>
  <ContactBand />
</Layout>
