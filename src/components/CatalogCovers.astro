---
import { site } from "../data";
import Arrow from "./Arrow.astro";
const covers = site.catalogs.filter((catalog) => catalog.cover);
---
{covers.length > 0 && (
  <div class="catalog-covers" aria-label="Portadas de los catálogos">
    <div class="cover-frame">
      {covers.map((catalog, index) => (
        <img src={catalog.cover} alt={`Portada de ${catalog.name}`} width="220" height="310" loading="lazy" class:list={{ "is-current": index === 0 }} aria-hidden={index > 0 ? "true" : undefined} />
      ))}
    </div>
    {covers.length > 1 && (
      <div class="cover-controls" hidden>
        <button type="button" data-previous-cover aria-label="Portada anterior"><Arrow /></button>
        <button type="button" data-toggle-covers aria-label="Pausar">
          <svg class="pause-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 3v10M10 3v10" />
          </svg>
          <svg class="play-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 3l8 5-8 5z" />
          </svg>
        </button>
        <button type="button" data-next-cover aria-label="Portada siguiente"><Arrow /></button>
      </div>
    )}
  </div>
)}

<script>
  const carousel = document.querySelector<HTMLElement>(".catalog-covers");
  const controls = carousel?.querySelector<HTMLElement>(".cover-controls");
  const toggle = controls?.querySelector<HTMLButtonElement>("[data-toggle-covers]");
  if (carousel && controls && toggle) {
    const covers = Array.from(carousel.querySelectorAll("img"));
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    let paused = reducedMotion.matches;
    let visible = false;
    let index = 0;
    let timer: number | undefined;

    function showCover(offset: number) {
      covers[index].classList.remove("is-current");
      covers[index].setAttribute("aria-hidden", "true");
      index = (index + offset + covers.length) % covers.length;
      covers[index].classList.add("is-current");
      covers[index].removeAttribute("aria-hidden");
    }

    function syncRotation() {
      window.clearInterval(timer);
      toggle!.setAttribute("aria-label", paused ? "Reproducir" : "Pausar");
      toggle!.classList.toggle("is-paused", paused);
      if (visible && !paused && !document.hidden && !carousel!.matches(":hover, :focus-within")) {
        timer = window.setInterval(() => showCover(1), 2000);
      }
    }

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      syncRotation();
    });
    observer.observe(carousel);
    controls.hidden = false;
    toggle.addEventListener("click", () => {
      paused = !paused;
      syncRotation();
    });
    controls.querySelector("[data-previous-cover]")?.addEventListener("click", () => showCover(-1));
    controls.querySelector("[data-next-cover]")?.addEventListener("click", () => showCover(1));
    carousel.addEventListener("mouseenter", syncRotation);
    carousel.addEventListener("mouseleave", syncRotation);
    carousel.addEventListener("focusin", syncRotation);
    carousel.addEventListener("focusout", () => requestAnimationFrame(syncRotation));
    document.addEventListener("visibilitychange", syncRotation);
    reducedMotion.addEventListener("change", () => {
      paused = reducedMotion.matches;
      syncRotation();
    });
    syncRotation();
  }
</script>

<style>
  .catalog-covers {
    width: min(220px, 100%);
    justify-self: center;
  }
  .cover-frame {
    display: grid;
    aspect-ratio: 220 / 310;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: white;
    overflow: hidden;
  }
  img {
    width: 100%;
    height: 100%;
    grid-area: 1 / 1;
    object-fit: contain;
    opacity: 0;
    transition: opacity 600ms ease-in-out;
  }
  img.is-current {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    img {
      transition: none;
    }
  }
  .cover-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 4px;
  }
  button {
    min-height: 44px;
    min-width: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--wine);
  }
  button:hover {
    background: var(--line);
  }
  [data-previous-cover] :global(svg) {
    transform: rotate(180deg);
  }
  .play-icon,
  .is-paused .pause-icon {
    display: none;
  }
  .is-paused .play-icon {
    display: block;
  }
</style>
