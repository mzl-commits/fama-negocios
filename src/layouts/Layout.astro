---
import "../styles/global.css";
import { site, whatsapp } from "../data";
import Arrow from "../components/Arrow.astro";
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = site.home.description, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { url: "/nosotros/", label: "Nosotros" },
  { url: "/divisiones/", label: "Soluciones" },
  { url: "/catalogos/", label: "Catálogos" },
  { url: "/proyectos/", label: "Galería" },
];
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#b82329" />
    <title>{title} | FAMA Negocios</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:title" content={`${title} | FAMA Negocios`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content={new URL("/assets/espacios.webp", Astro.site).href}
    />
    <meta
      name="fama-email-form"
      content={
        import.meta.env.PUBLIC_EMAIL_FORM === "true" ? "enabled" : "disabled"
      }
    />
    <meta
      name="fama-clarity-id"
      content={import.meta.env.PUBLIC_CLARITY_ID || ""}
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Ir al contenido
    </a>
    <div class="utility">
      <div class="container">
        <span>Soluciones para empresas y organizaciones</span>
        <a data-contact="email" href={`mailto:${site.contact.email}`}>
          {site.contact.email}
        </a>
      </div>
    </div>
    <header class="site-header">
      <div class="container nav-inner">
        <a href="/" class="brand" aria-label="FAMA Negocios — Inicio">
          <img src={site.brand.logo} width="54" height="54" alt="" />
          <span>
            FAMA<span>NEGOCIOS</span>
          </span>
        </a>
        <button
          class="menu-toggle"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="main-nav"
        >
          <span></span>
          <span></span>
        </button>
        <nav id="main-nav" aria-label="Navegación principal">
          {links.map((link) => (
            <a
              href={link.url}
              aria-current={path.startsWith(link.url) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
          <a href="/contacto/" class="button button-small">
            Solicitar cotización <Arrow diagonal />
          </a>
        </nav>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a
            class="brand brand-footer"
            href="/"
            aria-label="FAMA Negocios — Inicio"
          >
            <img src={site.brand.logo} width="50" height="50" alt="" />
            <span>
              FAMA<span>NEGOCIOS</span>
            </span>
          </a>
          <p>Publicidad, merchandising y servicios generales.</p>
          <a
            class="footer-mail"
            data-contact="email"
            href={`mailto:${site.contact.email}`}
          >
            {site.contact.email} <Arrow diagonal />
          </a>
        </div>
        <div>
          <h2>Secciones</h2>
          <a href="/nosotros/">Nosotros</a>
          <a href="/divisiones/">Nuestras soluciones</a>
          <a href="/catalogos/">Catálogos</a>
          <a href="/proyectos/">Galería</a>
          <a href="/star-home/">Star Home</a>
        </div>
        <div>
          <h2>Contacto comercial</h2>
          <a data-contact="phone" href={`tel:${site.contact.phoneHref}`}>
            {site.contact.phone}
          </a>
          <a
            data-contact="mobile"
            href={whatsapp()}
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp {site.contact.mobile}
          </a>
          <p data-contact="address">{site.contact.address}</p>
          <p data-contact="hours">{site.contact.hours}</p>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} FAMA Negocios</span>
      </div>
    </footer>
    <a
      class="whatsapp-float"
      data-whatsapp
      href={whatsapp()}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Consultar por WhatsApp"
    >
      <svg
        width="25"
        height="25"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.4-4.1A8 8 0 1 1 20 11.5Z" />
        <path d="M8 7.5c0 4.2 3.1 7.5 7.5 7.5l1-2.2-2.6-1-1 1c-1.5-.6-2.7-1.8-3.3-3.3l1-1L9.5 6Z" />
      </svg>
      <span>¿Conversamos?</span>
    </a>
    <script>
      import { initSite } from "../scripts/site";
      initSite();
    </script>
  </body>
</html>
